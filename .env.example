# Build-time variables for the VIN Cloud Solutions website.
# Copy to .env.local (git-ignored) only if you need to override a default.
# Everything prefixed VITE_ is embedded in the public JavaScript — never put secrets here.

# Formspree form that receives project requests (default below is the live form).
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mppqanpv
